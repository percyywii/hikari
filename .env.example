# Base URL for your application
NEXT_PUBLIC_URL=http://localhost:3000
# Replace with your website URL if deployed, otherwise keep localhost with your port.
# Ensure there is no trailing slash ("/") at the end.

# AniList API Configuration
GRAPHQL_ENDPOINT=https://graphql.anilist.co
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# NextAuth Configuration
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# MongoDB Connection URI
MONGODB_URI=

# Node Environment
NODE_ENV=development

# Optional comma-separated authorized streaming hostnames for production proxying
STREAM_ALLOWED_HOSTS=
HLS_PROXY_TIMEOUT_MS=15000